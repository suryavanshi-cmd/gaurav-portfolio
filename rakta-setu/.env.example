# ─────────────────────────────────────────────────────────────
# रक्त-सेतू  ·  configuration
# Copy to `.env` and fill in.  NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

# --- Server ---
PORT=3000
# Public base URL that patients will open from WhatsApp.
# In production this MUST be https (voice input requires a secure origin).
PUBLIC_BASE_URL=http://localhost:3000

# --- Lab identity (shown on the report page and in the WhatsApp message) ---
LAB_NAME=स्वस्तिक पॅथॉलॉजी लॅब
LAB_PHONE=+91XXXXXXXXXX
LAB_CITY=पुणे

# --- Deployment mode ---
# Where reports are stored: sqlite (a file on this PC) or supabase (Postgres).
# Leave blank to auto-detect: serverless hosts get supabase, everything else
# gets sqlite. A serverless deployment CANNOT use sqlite — its filesystem is
# ephemeral and not shared between function instances.
STORE_DRIVER=

# Only for the lab PC when the web app is hosted elsewhere (e.g. Vercel).
# The watcher then parses locally and pushes the parsed result to that
# deployment instead of writing to a local database. The raw PDF never leaves
# the lab. Issue the key with: node scripts/create-lab-key.js <lab-uuid>
REMOTE_INGEST_URL=
LAB_API_KEY=

# --- Folder watcher ---
# The folder your analyzer / LIS software writes finished reports into.
# On Windows use forward slashes, e.g. C:/BloodMachine/Reports
WATCH_DIR=./inbox
ARCHIVE_DIR=./archive
FAILED_DIR=./failed
# Wait this long after the last write before parsing (machine may still be writing).
WATCH_STABILITY_MS=4000

# --- Report links ---
# How long a patient link stays valid (hours). 0 = never expires.
LINK_TTL_HOURS=720
# Patients must confirm their birth year / last 4 digits of phone to open a report.
REQUIRE_PATIENT_VERIFICATION=true

# --- WhatsApp ---
# One of: cloud | twilio | console
# `console` just prints the message — use it while developing.
WHATSAPP_DRIVER=console

# Meta WhatsApp Cloud API (WHATSAPP_DRIVER=cloud)
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_ACCESS_TOKEN=
# Name of your APPROVED Marathi template (see docs/WHATSAPP.md)
WA_CLOUD_TEMPLATE_NAME=rakta_ahwal_taiyar
WA_CLOUD_TEMPLATE_LANG=mr
# Token you invent; put the same value in the Meta webhook config.
WA_WEBHOOK_VERIFY_TOKEN=

# Twilio (WHATSAPP_DRIVER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Default country code applied to 10-digit Indian numbers found in reports.
DEFAULT_COUNTRY_CODE=91

# --- AI (Marathi voice Q&A on the report page) ---
# Leave blank to run without AI — the page still works, using the built-in
# rule-based Marathi explanations and diet advice.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# --- Ops ---
# Comma-separated staff tokens for /api/admin/* endpoints.
ADMIN_TOKEN=change-me-to-a-long-random-string
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
#  पे-पर-यूज क्रेडिट · pay-per-use billing  (optional)
#
#  Everything below is OFF by default. With BILLING_ENABLED unset the app
#  behaves exactly as before: local PDF text extraction, free, unmetered.
#  Turn this on only for the AI extraction of SCANNED reports, which is the
#  path that actually costs money.
# ─────────────────────────────────────────────────────────────
BILLING_ENABLED=false

# --- Supabase (Postgres) ---
# The service role key bypasses row level security and can mint credit.
# Server-side only — never ship it to a browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Publishable key, safe in the frontend, used for user sign-in.
SUPABASE_ANON_KEY=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Invent this, then paste the same value into the Razorpay webhook config.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
MIN_TOPUP_INR=10
MAX_TOPUP_INR=50000

# --- Credit rate ---
# ₹10 = 9000 tokens → 900 tokens per rupee.
TOKENS_PER_INR=900
# Used to convert Anthropic's USD pricing into rupees for cost accounting.
USD_TO_INR_RATE=88

# --- Extraction model ---
# Rates come from the table in src/billing/pricing.js and follow this setting,
# so changing the model automatically changes the billing rate.
# Haiku 4.5: $1/$5 per million tokens, 200K context, 100-page PDF limit.
BILLING_MODEL=claude-haiku-4-5

# --- Pre-flight estimation ---
EXTRACTION_TOKENS_PER_PAGE=1000
EXTRACTION_OUTPUT_TOKENS_PER_PAGE=400
EXTRACTION_MAX_OUTPUT_TOKENS=8000
# Pad the hold so a slightly low estimate does not routinely overrun.
ESTIMATE_SAFETY_MARGIN=1.2
EXTRACTION_MAX_UPLOAD_BYTES=20971520

# --- Account-level safety cap (backstop) ---
# Stops ALL extraction platform-wide once this month's spend hits the number,
# regardless of individual user balances. This can only react after money is
# spent — set the real limit in the Anthropic Console as well.
MONTHLY_SPEND_CAP_USD=50
