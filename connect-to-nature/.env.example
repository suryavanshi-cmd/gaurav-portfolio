# ─── Supabase ────────────────────────────────────────────────────────────────
# Project → Settings → API. Without these the app boots in DEMO MODE: the seed
# data in src/lib/demo-data.ts is served read-only and no write reaches a database.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by admin approvals and the payment webhook, which have to
# write past row-level security. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Portals ─────────────────────────────────────────────────────────────────
# The customer portal is the root domain; the shetkari portal is a subdomain of
# it. middleware.ts rewrites the subdomain onto /shetkari, so both portals are
# one deployment against one database.
NEXT_PUBLIC_ROOT_DOMAIN=connecttonature.com
NEXT_PUBLIC_HOST_SUBDOMAIN=shetkari

# ─── Razorpay (UPI / cards / netbanking) ─────────────────────────────────────
# Absent: checkout completes in demo mode and the booking is marked
# payment_status = 'demo' instead of 'paid'.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
