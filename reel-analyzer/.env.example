# ---------------------------------------------------------------------------
# Supabase
# NEXT_PUBLIC_* is what the browser reads. The un-prefixed names are accepted as
# a fallback so this app matches the rest of the portfolio.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server only. Bypasses row-level security — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ---------------------------------------------------------------------------
# Analysis — Claude or Gemini
#
# Leave ANALYSIS_PROVIDER unset and whichever key is present is used, so a
# deployment that only has one of them just works. Set it explicitly to pin.
# ---------------------------------------------------------------------------
# ANALYSIS_PROVIDER=gemini

ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------------------
# Transcription
#
#   gemini     — reads the .mp4 directly with GEMINI_API_KEY. No ffmpeg, no
#                extra vendor, and the only option that works on Vercel.
#   assemblyai — managed; also in-request, but needs its own key.
#   local      — faster-whisper on your own machine via
#                scripts/local_whisper_worker.py. Free, but there is no worker
#                on a serverless deployment to pick the job up, so jobs would
#                sit in `transcribing` forever.
#
# Unset, whichever key is configured wins, Gemini first.
# ---------------------------------------------------------------------------
TRANSCRIPTION_PROVIDER=gemini

# Only for TRANSCRIPTION_PROVIDER=assemblyai
TRANSCRIPTION_API_KEY=

# Optional. Defaults to GEMINI_MODEL, then gemini-3.8-flash. Must be a general
# model — the dedicated gemini-*-transcribe models take audio only and reject
# video, which would put ffmpeg back in the pipeline.
# GEMINI_TRANSCRIPTION_MODEL=gemini-3.8-flash

# Shared secret the local worker presents. Required when TRANSCRIPTION_PROVIDER=local.
# Generate with: openssl rand -hex 32
WORKER_SHARED_SECRET=

# ---------------------------------------------------------------------------
# Link ingestion (optional — the upload path always works without it)
#
# Instagram Graph API, for your own professional account's reels. A long-lived
# access token goes in EXTRACTION_API_KEY.
#
# Set EXTRACTION_PROVIDER=none to disable the link path entirely; pasted links
# then fail immediately with a message asking for the file instead.
# ---------------------------------------------------------------------------
EXTRACTION_PROVIDER=meta
EXTRACTION_API_KEY=
# Only needed for the Facebook-Login flavour of the Graph API.
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Deployment
# Used for magic-link redirects. Vercel sets its own URL vars, so this is only
# needed locally or behind a custom domain.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
