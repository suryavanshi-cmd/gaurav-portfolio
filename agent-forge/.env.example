# ---------------------------------------------------------------- database
# From Supabase: Project Settings -> API. The SERVICE ROLE key, not the
# publishable one -- every table has RLS enabled with no permissive policy, so a
# publishable key reads nothing. Never expose this key to a browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ---------------------------------------------------------------- answering
# extractive : no model at all. Returns the retrieved passages with their
#              sources. Cannot hallucinate, costs nothing. This is the default.
# ollama     : free and local. `brew install ollama && ollama pull llama3.2`
# anthropic  : LLM_API_KEY = an Anthropic API key
# openai     : LLM_API_KEY = an OpenAI API key
LLM_PROVIDER=extractive

# Leave blank to use each provider's default.
#   ollama    -> llama3.2
#   anthropic -> claude-opus-5   (claude-haiku-4-5 is the cheaper option)
#   openai    -> gpt-4o-mini
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MAX_TOKENS=700

# --------------------------------------------------------------- retrieval
# Candidates pulled from each search before fusion. Higher costs almost nothing.
RETRIEVAL_POOL=40
# How closely a stored correction must match a question before it is applied.
CORRECTION_THRESHOLD=0.78

PORT=3000
MAX_UPLOAD_BYTES=26214400
